# Maintainer: Morgan Lowe <https://github.com/morganlowe/E621-cruiser>
pkgname=e621-cruiser
pkgver=2.0.0
pkgrel=1
pkgdesc="Native Rust desktop browser and downloader for e621"
arch=('x86_64')
url="https://github.com/morganlowe/E621-cruiser"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=(
    'libglvnd: OpenGL rendering'
    'xdg-desktop-portal: native folder picker'
)
makedepends=('cargo')
options=('!lto' '!debug')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/morganlowe/E621-cruiser/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

_srcdir_root() {
    if [ -d "${srcdir}/E621-cruiser-${pkgver}" ]; then
        printf '%s\n' "${srcdir}/E621-cruiser-${pkgver}"
    else
        printf '%s\n' "${srcdir}/${pkgname}-${pkgver}"
    fi
}

build() {
    cd "$(_srcdir_root)"
    cargo build --release --locked
}

package() {
    local srcdir_root
    srcdir_root="$(_srcdir_root)"

    install -Dm755 "${srcdir_root}/target/release/e621-cruiser" "${pkgdir}/usr/bin/e621-cruiser"
    ln -sf e621-cruiser "${pkgdir}/usr/bin/e621cruiser"

    install -Dm644 "${srcdir_root}/packaging/e621-cruiser.desktop" "${pkgdir}/usr/share/applications/e621-cruiser.desktop"
    install -Dm644 "${srcdir_root}/assets/e621-cruiser.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/e621-cruiser.svg"
    install -Dm644 "${srcdir_root}/assets/e621-cruiser.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/e621-cruiser.png"
    install -Dm644 "${srcdir_root}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
